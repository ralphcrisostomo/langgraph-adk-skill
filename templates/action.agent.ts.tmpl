import type { Action, Ctx } from './_types';
import { createAgent, tool } from 'langchain';
import { streamAgent, stepText, type TraceLine } from '../trace';
import { currentDateTime, printContextBar } from '../session-core';
// Multi-node patterns: import { StateGraph, START, END, Send, Command } from '@langchain/langgraph';
// import * as z from 'zod';

function printStep(ctx: Ctx, line: TraceLine) {
  const color =
    line.kind === 'node' ? ctx.log.cyan
      : line.kind === 'tool-end' ? ctx.log.green
        : line.kind === 'tool-error' ? ctx.log.red
          : line.kind === 'tool-start' ? ctx.log.yellow
            : ctx.log.dim;
  console.log(color(stepText(line)));
}

export const {{ACTION_CAMEL}}: Action = {
  name: '{{ACTION_NAME}}',
  description: '{{ACTION_DESCRIPTION}}',
  params: [
    // {{PARAM_DEFS}}
  ],
  run: async (values, ctx) => {
    // {{GRAPH_CONSTRUCTION}} — architect-generated, verified against context7.
    // Single-agent default; replace with a StateGraph for sequential/parallel/loop/coordinator/etc.
    const agent = createAgent({
      model: ctx.llm,
      tools: [/* {{TOOLS}} */],
      // Append the live date/time so the agent isn't guessing "now" (LLMs have no clock).
      systemPrompt: `{{SYSTEM_PROMPT}}\nCurrent date and time: ${currentDateTime()}`,
    });

    // Streams node/tool steps to the console (no ora). For a multi-turn session,
    // rename this file to .tsx and render <SessionApp respond={...}/> from
    // '../ink/SessionApp', driving each turn with streamAgent(agent, { messages }, onStep).
    const result = await streamAgent(
      agent,
      { messages: [{ role: 'user', content: String(values.input) }] },
      (line) => printStep(ctx, line),
    );

    const lastChunk = (result ?? {}) as Record<string, any>;
    const state = Array.isArray(lastChunk.messages)
      ? lastChunk
      : Object.values(lastChunk).find((v) => v && Array.isArray((v as any).messages)) ?? {};
    const messages = (state as any).messages ?? [];
    const final = messages[messages.length - 1]?.content ?? '';
    const text = typeof final === 'string' ? final : JSON.stringify(final);
    console.log(ctx.log.bold(text));

    // MANDATORY for LLM-using actions: surface the model id + context usage.
    printContextBar(ctx.log, ctx.contextWindow, [
      { role: 'user', content: String(values.input) },
      { role: 'assistant', content: text },
    ], ctx.model);
  },
};
