  run: async (values, ctx) => {
    // {{GRAPH_CONSTRUCTION}} — architect-generated, verified against context7.
    // Single-agent default; replace with a StateGraph for sequential/parallel/loop/coordinator/etc.
    const agent = createAgent({
      model: ctx.llm,
      tools: [/* {{TOOLS}} */],
      systemPrompt: '{{SYSTEM_PROMPT}}',
    });

    // Streams node/tool steps to the console (no ora). For a multi-turn session,
    // rename this file to .tsx and render <SessionApp respond={...}/> from
    // '../ink/SessionApp', driving each turn with streamAgent(agent, { messages }, onStep).
    const result = await streamAgent(
      agent,
      { messages: [{ role: 'user', content: String(values.input) }] },
      (line) => printStep(ctx, line),
    );

    const lastChunk = (result ?? {}) as Record<string, any>;
    const state = Array.isArray(lastChunk.messages)
      ? lastChunk
      : Object.values(lastChunk).find((v) => v && Array.isArray((v as any).messages)) ?? {};
    const messages = (state as any).messages ?? [];
    const final = messages[messages.length - 1]?.content ?? '';
    console.log(ctx.log.bold(typeof final === 'string' ? final : JSON.stringify(final)));
  },
};
