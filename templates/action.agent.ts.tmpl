function printStep(ctx: Ctx, line: TraceLine) {
  const color =
    line.kind === 'node' ? ctx.log.cyan
      : line.kind === 'tool-end' ? ctx.log.green
        : line.kind === 'tool-error' ? ctx.log.red
          : line.kind === 'tool-start' ? ctx.log.yellow
            : ctx.log.dim;
  console.log(color(stepText(line)));
}

